# ─── NeoContra environment ───────────────────────────────────────────────────
# Copy to `.env` for local dev, or set these as Railway service variables.
# All VITE_* vars are baked into the client at BUILD time (set them before build).

# ── Solana (native SOL payments) ──
# Treasury wallet that receives SOL for shop purchases / continues. Leave blank
# for DEV mode (shop + continue are granted free, no wallet/payment required):
VITE_DEV_WALLET=
# 'devnet' for testing, 'mainnet-beta' for launch:
VITE_SOLANA_NETWORK=devnet
# Dedicated RPC endpoint (Helius/QuickNode). Falls back to the public cluster
# URL if unset — use a real RPC for mainnet:
VITE_RPC_URL=

# ── $TOKEN (pump.fun) ──
# Paste the token's contract address (SPL mint) here AFTER you launch. Once set,
# a copyable "CA" bar appears in the UI (display only — no payment uses it yet).
# Leave blank before launch:
VITE_TOKEN_CA=
# Ticker shown beside the CA (e.g. $NEO). Defaults to $TOKEN if blank:
VITE_TOKEN_SYMBOL=

# ── Leaderboard ──
# Same-origin by default (the bundled server serves both). Only set this if the
# leaderboard API is hosted on a different origin than the game:
VITE_LEADERBOARD_URL=

# ── Server (runtime, NOT baked into the client) ──
# Where the SQLite file lives. On Railway, mount a Volume here:
DATA_DIR=/data
# Port (Railway sets this automatically):
PORT=3000
