# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
node_modules.old*
.e2e
dist
dist-ssr
*.local

# Local env (NEVER commit secrets/API keys); .env.example is the safe template
.env
.env.local
.env.*.local

# Server runtime data (SQLite leaderboard)
data/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Android / Solana dApp Store (TWA build) ──
# The generated Android project is reproducible from android/twa-manifest.json
# (`bubblewrap update`), so only that config is tracked — never the build output.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.apk
android/*.aab
android/*.idsig
# Release signing keys must NEVER be committed. The real one lives outside the
# repo entirely (see docs/DAPP_STORE.md); this is a safety net.
*.keystore
*.jks
